{
  "name": "devcapsule-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/preview.mjs --watch",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "content:fetch": "node scripts/fetch-content.mjs",
    "test:updates": "node scripts/update-check.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "cheerio": "1.2.0",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0"
  }
}
