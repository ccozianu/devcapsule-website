<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <script>(function(){var d=document.documentElement;try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")d.setAttribute("data-theme",t);}catch(e){}d.setAttribute("data-js","");})();</script>
  <title>{{ title }}{% if title != 'DevCapsule' %} · DevCapsule{% endif %}</title>
  <meta name="description" content="{{ entry.excerpt if entry else description or 'Development notes, decisions, and conversations from building DevCapsule.' }}">
  {% if preview %}<meta name="robots" content="noindex, nofollow">{% elif entry.noindex %}<meta name="robots" content="noindex">{% endif %}
  {% if origin %}<link rel="canonical" href="{{ origin }}{{ (entry.canonical if entry else page.url) | url }}">{% endif %}
  <meta property="og:title" content="{{ title }} · DevCapsule">
  <meta property="og:type" content="{{ 'article' if entry.kind == 'post' else 'website' }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="preload" href="{{ '/assets/fonts/atkinson-hyperlegible-latin-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/fraunces-latin-wght-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
  <script src="{{ '/assets/site.js' | url }}" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header band">
  <div class="wrap">
    <a class="brand" href="{{ '/' | url }}" aria-label="DevCapsule home"><span class="brand-mark" aria-hidden="true"><span></span></span>DevCapsule<span class="brand-dot">.</span></a>
    <nav aria-label="Main navigation">
      <a href="{{ site.current.url | url }}" {% if entry.kind == 'doc' or page.url == '/docs/' %}aria-current="true"{% endif %}>Docs</a>
      <a class="nav-start" href="{{ site.roles['getting-started'] | url }}">Start here</a>
      <a href="{{ '/journal/' | url }}" {% if entry.kind == 'post' or page.url == '/journal/' %}aria-current="true"{% endif %}>Journal</a>
      <a href="{{ '/releases/' | url }}" {% if entry.kind == 'release' or page.url == '/releases/' %}aria-current="true"{% endif %}>Releases</a>
      <a class="github-link" href="https://github.com/ccozianu/devcapsule">GitHub <span aria-hidden="true">↗</span></a>
      <button class="theme-toggle" type="button" aria-pressed="false" hidden>Night mode</button>
      <a class="nav-cta" href="{{ site.roles['getting-started'] | url }}">Start here <span aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>
<main id="main" tabindex="-1">{{ content | safe }}</main>
<footer class="site-footer">
  <div class="wrap">
    <div><a class="brand" href="{{ '/' | url }}">DevCapsule<span class="brand-dot">.</span></a><p>A project worth coming back to.</p></div>
    <nav aria-label="Footer"><a href="{{ site.current.url | url }}">Documentation {{ site.current.label }}</a><a href="{{ '/docs/' | url }}">All versions</a><a href="{{ '/journal/' | url }}">Development journal</a><a href="{{ '/releases/' | url }}">Releases</a>{% if site.landing.why %}<a href="{{ '/why/' | url }}">Why DevCapsule</a>{% endif %}<a href="{{ '/contribute/' | url }}">Contribute</a><a href="https://github.com/ccozianu/devcapsule/blob/main/DEVELOPING.md">For developers ↗</a><a href="https://github.com/ccozianu/devcapsule/blob/main/LICENSE">Apache-2.0 ↗</a></nav>
    <div class="footer-bottom">
      <span>Built in the open. Built with DevCapsule.{% if site.landing.badges %} <span class="badges">{{ site.landing.badges | safe }}</span>{% endif %}</span>
      <div class="build-details">
        <span>Site built <time datetime="{{ site.manifest.builtAt }}">{{ site.manifest.builtAt | buildtime }}</time></span>
        <a href="{{ '/build-info.json' | url }}">{{ 'Local preview' if preview else 'Build information' }} · {{ site.manifest.content.revision | shortsha }}</a>
      </div>
    </div>
  </div>
</footer>
<div class="sr-only" role="status" id="copy-status"></div>
</body>
</html>
