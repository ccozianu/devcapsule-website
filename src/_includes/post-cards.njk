<div class="post-cards">{% for post in site.posts %}<article class="post-card"><div class="eyebrow"><time datetime="{{ post.date }}">{{ post.dateLabel }}</time><span>{{ post.minutes }} min</span></div><h3><a href="{{ post.url | url }}">{{ post.title }} <span aria-hidden="true">↗</span></a></h3><p>{{ post.excerpt }}</p><a class="post-read" href="{{ post.url | url }}" aria-label="Read {{ post.title }}">Read the story <span aria-hidden="true">→</span></a></article>{% endfor %}</div>
