{% if entry.version.status == 'development' %}<aside class="version-banner banner-development"><strong>Unreleased.</strong> This is the documentation of the development version {{ entry.version.tokensVersion }} and may change. <a href="{{ site.current.url | url }}">Read the current version, {{ site.current.label }}.</a></aside>
{% elif entry.version.status == 'deprecated' %}<aside class="version-banner banner-deprecated"><strong>Deprecated.</strong> Version {{ entry.version.label }} still works but receives no further fixes; move to <a href="{{ entry.currentUrl | url }}">the current version, {{ site.current.label }}</a>, when you can.{% if entry.version.note %} {{ entry.version.note }}{% endif %}</aside>
{% elif entry.version.status == 'unsupported' %}<aside class="version-banner banner-unsupported"><strong>Unsupported.</strong> Version {{ entry.version.label }} is no longer maintained and the project does not say whether it still works. <a href="{{ site.current.url | url }}">Read the current version, {{ site.current.label }}.</a>{% if entry.version.note %} {{ entry.version.note }}{% endif %}</aside>
{% elif entry.version.note and entry.copy == 'version' %}<aside class="version-banner banner-note">{{ entry.version.note }}</aside>
{% endif %}
