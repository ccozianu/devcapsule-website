{% set landing = entry.landing %}
<div class="home">
<section class="hero band" aria-labelledby="{{ landing.hero.id }}">
  <div class="wrap">
    <div class="hero-copy">
      {% if landing.hero.chips.length %}<div class="eyebrow">{% for chip in landing.hero.chips %}{% if not loop.first %}<span aria-hidden="true"> · </span>{% endif %}{{ chip }}{% endfor %}</div>{% endif %}
      <h1 id="{{ landing.hero.id }}">{{ landing.hero.headline }}</h1>
      <div class="hero-lead">{{ landing.hero.lead | safe }}</div>
      <div class="hero-actions">
        <a class="button" href="{{ site.roles['getting-started'] | url }}">Open your first workspace <span class="button-version">{{ site.current.label }}</span></a>
        <a class="text-link" href="#what-you-get">See what you get ↓</a>
      </div>
    </div>
    <div class="workspace-figure" role="img" aria-label="A project workspace brings together your source, a full IDE, optional AI agents, and persistent project context. Access to host resources is your choice.">
      <div class="figure-top"><span class="tiny-caps">Workspace / DevCapsule</span><span class="figure-dots">● ● ●</span></div>
      <div class="workspace-scene">
        <div class="project-tab"><span aria-hidden="true">⌘</span> your-project <span class="tab-branch">main</span></div>
        <div class="scene-body"><div class="file-tree"><span>EXPLORER</span><div>⌄ your-project</div><div class="file-indent">▱ src/</div><div class="file-indent">▱ tests/</div><div class="file-indent selected">≡ README.md</div><div class="file-indent">≡ AGENTS.md</div></div><div class="scene-editor"><div class="editor-label">A little structure. Room to build.</div><div class="code-line"><i>01</i><b>Your source</b></div><div class="code-line"><i>02</i><span>Your tools</span></div><div class="code-line"><i>03</i><span>Your project memory</span></div><div class="editor-rule"></div><div class="terminal-prompt"><span>›</span> ready for your next idea<span class="cursor"></span></div></div></div>
        <div class="scene-status"><span><span class="status-dot"></span> A full IDE inside your capsule</span><span>◇</span></div>
      </div>
      <div class="capsule-parts"><span>Source & tools</span><span>Optional AI</span><span>Persistent context</span></div>
      <div class="boundary-line"><span>Host access</span><span class="boundary-switch" aria-hidden="true"></span><strong>You decide.</strong></div>
      <div class="figure-caption">01 / A workspace with a boundary.</div>
    </div>
  </div>
</section>

<section class="section section--tight" aria-label="Start by what you want to do">
  <div class="wrap">
    <div class="pillars">
      {% for pillar in landing.pillars %}
      <a class="pillar" href="{{ pillar.url | url }}">
        <span class="eyebrow">{{ loop.index }} / {{ 'Try it' if pillar.role == 'getting-started' else ('Your project' if pillar.role == 'your-project' else 'Your agent') }}</span>
        <h2>{{ pillar.title }}</h2>
        <p>{{ pillar.description }}</p>
        <span class="pillar-action">Read the guide <span aria-hidden="true">→</span></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{% if landing.benefits.length %}
<section class="section section--alt" id="what-you-get" aria-labelledby="what-you-get-heading">
  <div class="wrap">
    <div class="section-heading"><div><span class="eyebrow">What you get</span><h2 id="what-you-get-heading">What changes how a day of work feels</h2></div></div>
    <div class="cards cards--{{ landing.benefits.length }}">
      {% for card in landing.benefits %}
      <div class="card">
        {% if card.headline %}<h3>{{ card.headline }}</h3>{% endif %}
        <div class="card-body">{{ card.html | safe }}</div>
        {% if card.url %}<a class="card-link" href="{{ card.url }}">{{ card.label }} <span aria-hidden="true">→</span></a>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if landing.fit.columns.length %}
<section class="section" aria-labelledby="{{ landing.fit.id or 'fit-heading' }}">
  <div class="wrap">
    <div class="section-heading"><div><span class="eyebrow">Is it for you?</span><h2 id="{{ landing.fit.id or 'fit-heading' }}">{{ landing.fit.heading or 'Is it for you?' }}</h2></div>{% if landing.why %}<a class="text-link" href="{{ '/why/' | url }}">The long answer ↗</a>{% endif %}</div>
    <div class="fit-columns">
      {% for column in landing.fit.columns %}
      <div class="fit-column prose">{% if column.heading %}<h3 id="fit-{{ loop.index }}">{{ column.heading }}</h3>{% endif %}{{ column.html | safe }}</div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="journal-section section section--alt" aria-labelledby="journal-heading">
  <div class="wrap">
    <div class="section-heading"><div><span class="eyebrow">Built with itself</span><h2 id="journal-heading">The development journal<span class="brand-dot">.</span></h2>{% if landing.dogfood %}<div class="dogfood prose">{{ landing.dogfood | safe }}</div>{% endif %}</div><a class="text-link" href="{{ '/journal/' | url }}">All entries ↗</a></div>
    {% set cards = site.posts.slice(0, 3) %}
    <div class="post-cards">{% for post in cards %}<article class="post-card"><div class="eyebrow"><time datetime="{{ post.date }}">{{ post.dateLabel }}</time><span>{{ post.minutes }} min</span></div><h3><a href="{{ post.url | url }}">{{ post.title }} <span aria-hidden="true">↗</span></a></h3><p>{{ post.excerpt }}</p><a class="post-read" href="{{ post.url | url }}" aria-label="Read {{ post.title }}">Read the story <span aria-hidden="true">→</span></a></article>{% endfor %}</div>
  </div>
</section>

<section class="closing band">
  <div class="wrap closing-grid">
    <div>
      <span class="eyebrow">Start here</span>
      <h2>Open your first workspace.</h2>
      <a class="button" href="{{ site.roles['getting-started'] | url }}">Start here <span class="button-version">{{ site.current.label }}</span></a>
    </div>
    <div class="closing-aside">
      {% if landing.contribute %}<div class="prose">{{ landing.contribute.paragraphs[0] | safe }}</div>{% endif %}
      <a class="text-link" href="{{ '/contribute/' | url }}">{{ 'Contribute' if landing.contribute else 'Want to help? Contributing, coming soon' }} ↗</a>
    </div>
  </div>
</section>
</div>
