<div class="home">
<section class="hero" aria-labelledby="{{ entry.landing.id }}">
  <div class="hero-copy">
    <div class="eyebrow"><span class="status-dot"></span> Your project. Your IDE. Your AI.</div>
    <h1 id="{{ entry.landing.id }}">{{ entry.landing.headline }}</h1>
    <div class="hero-lead">{{ entry.landing.lead | safe }}</div>
    <div class="hero-actions"><a class="button" href="{{ '/docs/guides/first-session/' | url }}">Open your first workspace <span aria-hidden="true">↗</span></a><a class="text-link" href="https://github.com/ccozianu/devcapsule">Explore on GitHub ↗</a></div>
    <div class="hero-platform">Linux x86-64 <span>·</span> Windows via WSL2 <span>·</span> Open source</div>
  </div>
  <div class="workspace-figure" role="img" aria-label="A project workspace brings together your source, a full IDE, optional AI agents, and persistent project context. Access to host resources is your choice.">
    <div class="figure-top"><span class="tiny-caps">Workspace / DevCapsule</span><span class="figure-dots">● ● ●</span></div>
    <div class="workspace-scene">
      <div class="project-tab"><span aria-hidden="true">⌘</span> your-project <span class="tab-branch">main</span></div>
      <div class="scene-body"><div class="file-tree"><span>EXPLORER</span><div>⌄ your-project</div><div class="file-indent">▱ src/</div><div class="file-indent">▱ tests/</div><div class="file-indent selected">≡ README.md</div><div class="file-indent">≡ AGENTS.md</div></div><div class="scene-editor"><div class="editor-label">A little structure. Room to build.</div><div class="code-line"><i>01</i><b>Your source</b></div><div class="code-line"><i>02</i><span>Your tools</span></div><div class="code-line"><i>03</i><span>Your project memory</span></div><div class="editor-rule"></div><div class="terminal-prompt"><span>›</span> ready for your next idea<span class="cursor"></span></div></div></div>
      <div class="scene-status"><span><span class="status-dot"></span> A full IDE inside your capsule</span><span>◇</span></div>
    </div>
    <div class="capsule-parts"><span>Source & tools</span><span>Optional AI</span><span>Persistent context</span></div>
    <div class="boundary-line"><span>Host access</span><span class="boundary-switch" aria-hidden="true"></span><strong>You decide.</strong></div>
    <div class="figure-caption">01 / A workspace with a boundary.</div>
  </div>
</section>
<div class="health-strip"><span class="eyebrow">Built in the open</span><div class="badges">{{ entry.landing.badges | safe }}</div><a href="https://github.com/ccozianu/devcapsule/releases">Releases <span aria-hidden="true">↗</span></a></div>
<section class="intro-section" aria-labelledby="{{ entry.landing.intro.id }}"><div><span class="eyebrow">Ready when you are</span><h2 id="{{ entry.landing.intro.id }}">{{ entry.landing.intro.heading }}</h2><div class="motto">{{ entry.landing.motto | safe }}</div></div><div class="prose intro-prose">{{ entry.landing.intro.html | safe }}</div></section>
<section class="features" aria-label="Work inside the capsule">{% for feature in entry.landing.features %}<div class="feature"><span class="feature-number">0{{ loop.index }} / {{ 'The workspace' if loop.first else 'The coding partner' }}</span><div class="feature-content">{{ feature | safe }}</div><span class="feature-symbol" aria-hidden="true">{{ '⌘' if loop.first else '↗' }}</span></div>{% endfor %}</section>
<section class="boundary-section"><div class="eyebrow"><span aria-hidden="true">⊞</span> A boundary you control</div><div class="prose">{{ entry.landing.boundary | safe }}</div></section>
<section class="philosophy" aria-labelledby="{{ entry.landing.philosophy.id }}"><div><span class="eyebrow">The longer game</span><h2 id="{{ entry.landing.philosophy.id }}">{{ entry.landing.philosophy.heading }}</h2></div><div class="prose">{{ entry.landing.philosophy.html | safe }}</div></section>
{% if entry.landing.comparison %}<section class="comparison"><h2 id="{{ entry.landing.comparison.id }}">{{ entry.landing.comparison.heading }}</h2><div class="prose">{{ entry.landing.comparison.html | safe }}</div></section>{% endif %}
<section class="journal-section" aria-labelledby="journal-heading"><div class="section-heading"><div><span class="eyebrow">Notes from the workbench</span><h2 id="journal-heading">The development journal<span class="brand-dot">.</span></h2></div><a class="text-link" href="{{ '/blog/' | url }}">All entries ↗</a></div>{% include 'post-cards.njk' %}</section>
<section class="closing"><span class="eyebrow">For the really, really curious</span><h2>Open your first workspace.</h2><a class="button" href="{{ '/docs/guides/first-session/' | url }}">Let’s get started <span aria-hidden="true">↗</span></a></section>
</div>
